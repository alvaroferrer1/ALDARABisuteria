# Copia este archivo a .env.local y rellena lo que necesites.
# Nada de esto es obligatorio para ejecutar la web en local: sin
# ninguna variable definida, todo funciona en modo demo/local.

# Firma las cookies de sesión de /account (y del panel /admin/analytics,
# que reutiliza el mismo secreto). Sin esto se usa un secreto de
# desarrollo fijo (inseguro para producción real).
AUTH_SECRET=

# Contraseña del panel interno de analítica local (/admin/analytics, no
# enlazado desde ninguna navegación pública). Sin esto se usa una
# contraseña demo fija — cámbiala antes de desplegar de verdad.
ADMIN_ANALYTICS_PASSWORD=

# Cabecera compartida para POST /api/admin/restock (simula reposición de
# stock y dispara los avisos de "Back in Stock" pendientes). Sin esto se
# usa un valor demo fijo — cámbialo antes de desplegar de verdad.
RESTOCK_ADMIN_SECRET=

# ---------------------------------------------------------------
# Integraciones futuras (NO conectadas todavía). La web funciona sin
# ellas: los pedidos, mensajes y newsletter se guardan en archivos
# JSON locales dentro de /data. Documentado también en README.md.
# ---------------------------------------------------------------

# Pasarela de pago real (Stripe). Sin esto, el checkout queda en modo
# "pedido de demostración" (sin cobro real).
# Consíguelas en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Envío de emails transaccionales reales (confirmación de pedido,
# bienvenida...). Sin esto, no se envía ningún email.
# Consíguela en https://resend.com/api-keys
RESEND_API_KEY=

# Número de WhatsApp real de ALDARA (formato 34XXXXXXXXX), usado en
# los enlaces "Escríbenos por WhatsApp" de toda la web.
NEXT_PUBLIC_WHATSAPP_NUMBER=
